<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>detection_3d_estimators</name>
  <version>0.1.0</version>
  <description>
    2D detections placed in 3D: each detection on the ray of the center of its box, at the
    distance of a depth image, or estimated from a single image when the camera has no depth (a
    fixed distance, the real size of what was detected, or a monocular depth network).
  </description>
  <maintainer email="rodrigo.perez@urjc.es">Rodrigo Pérez-Rodríguez</maintainer>
  <license>Apache-2.0</license>
  <author email="rodrigo.perez@urjc.es">Rodrigo Pérez-Rodríguez</author>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- depth_anything only (not installed by rosdep): pip install torch transformers -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
